# ─────────────────────────────────────────────────────────────
# Hard Rock Gym — Template de variáveis de ambiente
#
# COPIA este ficheiro para `.env` e substitui TODOS os valores.
# NUNCA faças commit do .env real. Está no .gitignore.
#
# Para gerar secrets fortes:
#   openssl rand -base64 32    # passwords
#   openssl rand -base64 64    # JWT_SECRET
#   openssl rand -hex 32       # webhook secret
# ─────────────────────────────────────────────────────────────

# ─── Domínio ────────────────────────────────────────────────
# O domínio público que o Caddy vai servir (HTTPS automático).
SITE_ADDRESS=lariussport.duckdns.org

# URL do frontend (usado em emails de recuperação, links de retorno de pagamento).
FRONTEND_URL=https://lariussport.duckdns.org

# CORS whitelist — separado por vírgulas. OWASP A01.
APP_CORS_ALLOWED_ORIGINS=https://lariussport.duckdns.org

# ─── PostgreSQL ─────────────────────────────────────────────
# NÃO usar "postgres/postgres" em produção.
POSTGRES_USER=gym_admin
POSTGRES_PASSWORD=TROCAR-por-openssl-rand-base64-32

# ─── RabbitMQ ───────────────────────────────────────────────
# NÃO usar "guest/guest" em produção.
RABBITMQ_USER=gym_mq
RABBITMQ_PASSWORD=TROCAR-por-openssl-rand-base64-32

# ─── JWT ────────────────────────────────────────────────────
# OWASP A02. Mínimo 256 bits (32 bytes) para HS256; gera 64 bytes para folga.
JWT_SECRET=TROCAR-por-openssl-rand-base64-64

# ─── Mail (notificações) ────────────────────────────────────
# Gmail: gerar App Password em https://myaccount.google.com/apppasswords
# Não usar a password da conta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=app-password-de-16-caracteres

# ─── App ────────────────────────────────────────────────────
APP_NAME=Hard Rock Gym

# ─── PaySuite (gateway de pagamentos) ───────────────────────
# Token da conta: painel https://paysuite.tech
PAYSUITE_TOKEN=xxxx|xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC secret usado para validar webhooks recebidos. OBRIGATÓRIO em produção.
PAYSUITE_WEBHOOK_SECRET=TROCAR-por-openssl-rand-hex-32

# Força validação da assinatura do webhook. SEMPRE true em produção.
PAYSUITE_WEBHOOK_REQUIRED=true

# URLs de callback (PaySuite notifica aqui) e retorno (browser volta após pagar).
PAYSUITE_CALLBACK_URL=https://lariussport.duckdns.org/api/v1/checkout/webhook
PAYSUITE_RETURN_URL=https://lariussport.duckdns.org/pagamento/retorno

# ─── Rate limiting (OWASP A07) ──────────────────────────────
# Máximo de tentativas em LOGIN_WINDOW_SECONDS por IP+endpoint.
APP_SECURITY_RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
APP_SECURITY_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
